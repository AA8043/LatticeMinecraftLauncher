                    "${quickPlaySingleplayer}"
                ]
            },
            {
                "rules": [
                    {
                        "action": "allow",
                        "features": {
                            "is_quick_play_multiplayer": true
                        }
                    }
                ],
                "value": [
                    "--quickPlayMultiplayer",
                    "${quickPlayMultiplayer}"
                ]
            },
            {
                "rules": [
                    {
                        "action": "allow",
                        "features": {
                            "is_quick_play_realms": true
                        }
                    }
                ],
                "value": [
                    "--quickPlayRealms",
                    "${quickPlayRealms}"
                ]
            }
        ]
