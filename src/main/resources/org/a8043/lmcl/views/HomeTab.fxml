<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<AnchorPane fx:id="content" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.a8043.lmcl.views.HomeTab">
    <children>
        <Button layoutX="502.0" layoutY="343.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
                minWidth="-Infinity" mnemonicParsing="false" onAction="#startGame" prefHeight="50.0" prefWidth="180.0"
                styleClass="start-game-button" text="%tabs.home.start" AnchorPane.bottomAnchor="10.0"
                AnchorPane.rightAnchor="10.0"/>
        <VBox alignment="CENTER" layoutX="29.0" layoutY="-46.0" prefHeight="120.0" prefWidth="132.0"
              AnchorPane.bottomAnchor="312.4" AnchorPane.rightAnchor="29.400000000000006" onMouseClicked="#manageUser"
              styleClass="user-box">
            <children>
                <ImageView fx:id="userImage" fitHeight="64.0" fitWidth="64.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="/icons/slash.png"/>
                    </image>
                </ImageView>
                <Label fx:id="userName" text="%tabs.home.user.noneTip"/>
            </children>
        </VBox>
        <HBox alignment="CENTER_LEFT" layoutX="450.0" layoutY="152.0" prefHeight="81.0" prefWidth="180.0"
              AnchorPane.bottomAnchor="200.0" AnchorPane.rightAnchor="10.0" onMouseClicked="#manageGame"
              styleClass="game-box">
            <children>
                <ImageView fx:id="gameImage" fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="/icons/slash.png"/>
                    </image>
                </ImageView>
                <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                    <children>
                        <Label fx:id="gameName" text="%tabs.home.game.none">
                            <font>
                                <Font size="16.0"/>
                            </font>
                        </Label>
                        <Label fx:id="gameDescription" text="%tabs.home.game.noneTip"/>
                    </children>
                </VBox>
            </children>
        </HBox>
        <ListView fx:id="instancesList" layoutX="450.0" layoutY="212.0" prefHeight="120.0" prefWidth="180.0"
                  AnchorPane.bottomAnchor="68.0" AnchorPane.rightAnchor="10.0"/>
    </children>
</AnchorPane>
